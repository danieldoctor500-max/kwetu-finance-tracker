# Application
# Set explicitly. Production authentication cookies require HTTPS.
NODE_ENV=development
APP_NAME=Kwetu Finance Tracker
FRONTEND_PORT=5173
BACKEND_PORT=3000

# PostgreSQL
POSTGRES_DB=kwetu_finance_tracker
POSTGRES_USER=kwetu_app
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_PORT=5433

# Backend database connection
DATABASE_URL=postgresql://kwetu_app:CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD@db:5432/kwetu_finance_tracker?schema=public

# Authentication
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES_LONG
JWT_ACCESS_EXPIRES_IN=15m

# Frontend API
VITE_API_BASE_URL=/api/v1