generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ThemePreference {
  LIGHT
  DARK
}

enum FinancialAccountType {
  CASH
  BANK
  MOBILE_MONEY
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum SavingsGoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum IssueReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  fullName        String          @db.VarChar(120)
  email           String          @unique @db.VarChar(254)
  phone           String?         @db.VarChar(32)
  currency        String          @default("KES") @db.VarChar(3)
  financialPreferences   Json     @default("{}")
  notificationPreferences Json     @default("{}")
  passwordHash    String          @db.VarChar(255)
  role            UserRole        @default(USER)
  isActive        Boolean         @default(true)
  profilePhoto    String?         @db.Text
  themePreference ThemePreference @default(LIGHT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  savingsGoals SavingsGoal[]
  accounts     FinancialAccount[]
  transfers    Transfer[]
  auditEvents   AdminAuditEvent[] @relation("AdminAuditActor")
  auditTargets  AdminAuditEvent[]
  supportReports IssueReport[]

  @@index([createdAt])
}

model Category {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  name      String          @db.VarChar(80)
  type      TransactionType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name, type])
  @@index([userId, type])
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  categoryId  String          @db.Uuid
  accountId   String?         @db.Uuid
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  description String?         @db.VarChar(500)
  merchant    String?         @db.VarChar(120)
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account  FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
  @@index([userId, type, occurredAt])
  @@index([categoryId])
  @@index([accountId, occurredAt])
}

model FinancialAccount {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @db.Uuid
  name          String               @db.VarChar(80)
  type          FinancialAccountType
  provider      String?              @db.VarChar(80)
  openingBalance Decimal             @default(0) @db.Decimal(12, 2)
  currency      String               @default("KES") @db.VarChar(3)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  outgoingTransfers Transfer[]   @relation("TransferSource")
  incomingTransfers Transfer[]   @relation("TransferDestination")

  @@unique([userId, name])
  @@index([userId, type])
}

model Transfer {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  fromAccountId   String   @db.Uuid
  toAccountId     String   @db.Uuid
  amount          Decimal  @db.Decimal(12, 2)
  description     String?  @db.VarChar(240)
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount FinancialAccount @relation("TransferSource", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   FinancialAccount @relation("TransferDestination", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
  @@index([fromAccountId, occurredAt])
  @@index([toAccountId, occurredAt])
}

model Budget {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  categoryId  String   @db.Uuid
  periodMonth String   @db.VarChar(7)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, categoryId, periodMonth])
  @@index([userId, periodMonth])
}

model SavingsGoal {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @db.Uuid
  name          String            @db.VarChar(120)
  targetAmount  Decimal           @db.Decimal(12, 2)
  currentAmount Decimal           @default(0) @db.Decimal(12, 2)
  deadline      DateTime?
  status        SavingsGoalStatus @default(ACTIVE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model PlatformCategoryTemplate {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @db.VarChar(80)
  type      TransactionType
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([name, type])
  @@index([isActive, type])
}

model PlatformSetting {
  key       String   @id @db.VarChar(80)
  value     Json
  updatedAt DateTime @updatedAt
}

model AdminAuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  action       String   @db.VarChar(80)
  targetUserId String?  @db.Uuid
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  actor  User? @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target User? @relation(fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
}

model IssueReport {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  subject        String             @db.VarChar(160)
  description    String             @db.VarChar(2000)
  status         IssueReportStatus  @default(OPEN)
  adminNote      String?            @db.VarChar(1000)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}
